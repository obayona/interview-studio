---
import { Icon } from '../../components/ui/Icon';
import { ProcessForm } from '../../features/processes/ProcessForm';
import AppLayout from '../../layouts/AppLayout.astro';
---

<AppLayout title="Create interview process">
  <section class="page">
    <a class="page__back-link" href="/processes">
      <Icon name="arrowLeft" />
      Back to processes
    </a>
    <h2 class="page__heading" transition:name="process-page-title">
      Create interview process
    </h2>
    <p class="page__intro">
      Add role context and tailor each optional interview stage.
    </p>
    <ProcessForm mode="create" client:load />
  </section>
</AppLayout>
