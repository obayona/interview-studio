# Copy this file to .env, replace every placeholder, then run:
#   chmod 600 .env
#   ./deployment/scripts/install.sh

DEPLOYMENT_ENV=production
DOMAIN=interviews.example.com
LETSENCRYPT_EMAIL=admin@example.com
LETSENCRYPT_STAGING=false

APP_USERNAME=owner
# Use a unique password of at least 16 characters.
APP_PASSWORD=replace-with-a-long-random-password
# Generate with: openssl rand -base64 32
APP_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
APP_SESSION_LIFETIME_SECONDS=86400

# Host directory used by backup and restore tooling.
BACKUP_DIR=./backups
